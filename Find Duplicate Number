let arr = [4,66,4,2,6,3,6,5];

function findDuplicates(arr){

  let duplicates = [];

  for(let i=0; i<arr.length; i++){

    for(j=i+1; j<arr.length; j++){

      if(arr[i] === arr[j] && !duplicates.includes(arr[i])){

      duplicates.push(arr[i]);

      }
    }     
  }
    return duplicates;
}

