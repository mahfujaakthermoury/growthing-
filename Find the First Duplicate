let arr = [4, 66, 4, 2, 6, 3, 6, 5];

function firstDuplicate(arr) {
    for (let i = 0; i < arr.length; i++) {

    for (let j = 0; j < i; j++) {

       if(arr[i] === arr[j]){
          return arr[i]
       } // compare arr[i] and arr[j]

    }
  }
}

console.log(firstDuplicate([5, 3, 7, 3, 2, 5]));
